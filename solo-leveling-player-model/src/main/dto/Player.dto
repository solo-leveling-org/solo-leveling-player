export com.sleepkqq.sololeveling.player.model.entity.player.Player
  -> package com.sleepkqq.sololeveling.player.model.entity.player.dto

PlayerView {
  #allScalars

  -createdAt

  -updatedAt

  -version

  level {
    #allScalars

    -createdAt

    -updatedAt

    -version
  }

  balance {
    #allScalars

    -createdAt

    -updatedAt

    -version
  }

  taskTopics {
    #allScalars

    -createdAt

    -updatedAt

    -version

    level {
      #allScalars

      -createdAt

      -updatedAt

      -version
    }
  }
}

ResetPlayerView {
  #allScalars

  level {
    #allScalars
  }

  balance {
    #allScalars
  }

  taskTopics {
    #allScalars

    level {
      #allScalars
    }
  }

  stamina {
    #allScalars
  }

  dayStreak {
    #allScalars
  }
}

unsafe ActiveTasksPlayerView {
  tasks {
    #allScalars

    -version

    task! {
      #allScalars

      -createdAt

      -updatedAt

      -version

      title! {
        #allScalars
      }

      description! {
        #allScalars
      }

      topics {
        #allScalars
      }
    }
  }

  stamina! {
    #allScalars

    -createdAt

    -version
  }

  dayStreak! {
    #allScalars

    -createdAt

    -version
  }
}

GenerateTasksPlayerView {
  taskTopics {
    taskTopic

    active

    level {
      level
    }
  }
}